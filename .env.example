# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=your-gemini-api-key

# Optional
GEMINI_MODEL=gemini-2.5-flash
BATCH_SIZE=2
PDF_DPI=200
USE_MOCK_MODE=false

# LangSmith tracing (optional). Don't also set LANGSMITH_PROJECT.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_AGENT_ID=medical-bill-extractor
LANGSMITH_AGENT_ENVIRONMENT=local
# Page images in traces: off by default. Bills contain patient data; keep off for the public demo.
LANGSMITH_INCLUDE_IMAGES=false

# Self-hosted comparison model (serving/modal_vllm.py). Proxy-auth token from Modal settings > Proxy Auth Tokens.
TOKENID=wk-...
TOKEN_SECRET=ws-...
MODAL_VLLM_BASE_URL=https://<workspace>--bill-vlm-serve.modal.run/v1
MODAL_VLLM_MODEL=medical-bill
